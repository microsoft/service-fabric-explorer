{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "paths": {
      "src/*": ["./src/*"]
    },
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": false,
    "experimentalDecorators": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022"
  },
  "angularCompilerOptions": {
    "strictTemplates": false,
    "strictInjectionParameters": true
  }
}
