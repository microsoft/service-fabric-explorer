{
	"servers": {
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/"
		},
		"chrome-devtools": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"chrome-devtools-mcp@latest"
			]
		},
		"playwright": {
		"type": "stdio",
		"command": "npx",
		"args": [
			"-y",
			"@playwright/mcp@latest"
		]
		},
	},
	"inputs": []
}